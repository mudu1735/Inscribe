# Falcon Newsroom local development configuration
# Copy this file to .env at the repository root and replace placeholders.
# Never put real production secrets in this tracked example.

# Required application settings
FLASK_ENV=development
FLASK_SECRET_KEY=replace-with-a-unique-random-secret-of-at-least-32-characters
MONGO_URI=mongodb+srv://username:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=inscribe_local

# Browser/API origins
FRONTEND_ORIGIN=http://127.0.0.1:5173
TRUSTED_CSRF_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
TRUST_PROXY_HEADERS=0

# Comma-separated accounts that administer the platform and create workspaces
OWNER_EMAILS=owner@example.com

# Optional bootstrap workspace. Leave these commented for normal installations;
# owners can create workspaces in the application. Publication URLs are always
# configured per workspace and are intentionally not environment variables.
# DEFAULT_WORKSPACE_ID=local-newsroom
# DEFAULT_WORKSPACE_NAME=Local Newsroom
# DEFAULT_WORKSPACE_JOIN_CODE=LOCAL123
# DEFAULT_PLATFORM_TYPE=SNO Sites / WordPress

# Optional Google authentication and Drive integration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_TOKEN_ENCRYPTION_KEY=
GOOGLE_AUTH_REDIRECT_URI=http://127.0.0.1:5173/api/auth/google/callback
# Platform-wide login restriction, not a workspace publication-domain setting.
GOOGLE_ALLOWED_DOMAINS=
GOOGLE_PICKER_API_KEY=
GOOGLE_PICKER_APP_ID=
GOOGLE_PICKER_CLIENT_ID=

# Optional article/interviewee extraction
GEMINI_API_KEY=
GEMINI_MODEL=
