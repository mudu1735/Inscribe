{
  "name": "inscribe-falcon-newsroom",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "node ./scripts/dev.mjs",
    "dev:vite": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:auth": "node ./scripts/run-python.mjs -B -m server.auth_app",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test:frontend": "node ./scripts/static-check.mjs && npm run typecheck && npm run build",
    "test:backend": "node ./scripts/run-python.mjs -m unittest discover -s server -p test_*.py -v",
    "test": "npm run test:frontend && npm run test:backend"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.14.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^6.0.3",
    "vite": "^7.0.0"
  }
}
